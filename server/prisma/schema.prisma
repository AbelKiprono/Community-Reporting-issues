generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}

model User {
  id            Int             @id @default(autoincrement())
  fullName      String          @map("full_name") @db.VarChar(100)
  email         String          @unique @db.VarChar(120)
  passwordHash  String          @map("password_hash")
  phone         String?         @db.VarChar(20)
  role          String          @default("citizen") @db.VarChar(10)
  ward          String?         @db.VarChar(80)
  createdAt     DateTime        @default(now()) @map("created_at")
  issues        Issue[]
  upvotes       IssueUpvote[]
  statusChanges StatusHistory[] @relation("ChangedBy")

  @@map("users")
}

model Category {
  id         Int     @id @default(autoincrement())
  name       String  @unique @db.VarChar(60)
  baseWeight Int     @default(1) @map("base_weight")
  issues     Issue[]

  @@map("categories")
}

model Issue {
  id             Int       @id @default(autoincrement())
  userId         Int?      @map("user_id")
  categoryId     Int?      @map("category_id")
  title          String    @db.VarChar(150)
  description    String
   imageUrl       String?   @map("image_url") @db.Text
  lat            Float
  lng            Float
  addressText    String?   @map("address_text") @db.VarChar(255)
  status         String    @default("pending") @db.VarChar(15)
  urgencyScore   Int       @default(0) @map("urgency_score")
  upvotes        Int       @default(0)
  mlCategoryHint String?   @map("ml_category_hint") @db.VarChar(100)
  mlUrgencyHint  String?   @map("ml_urgency_hint") @db.VarChar(50)
  adminNote      String?   @map("admin_note")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  category      Category?       @relation(fields: [categoryId], references: [id])
  upvoteRecords IssueUpvote[]
  history       StatusHistory[]

  @@index([status])
  @@index([urgencyScore])
  @@map("issues")
}

model IssueUpvote {
  issueId Int   @map("issue_id")
  userId  Int   @map("user_id")
  issue   Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([issueId, userId])
  @@map("issue_upvotes")
}

model StatusHistory {
  id        Int      @id @default(autoincrement())
  issueId   Int      @map("issue_id")
  oldStatus String?  @map("old_status") @db.VarChar(15)
  newStatus String   @map("new_status") @db.VarChar(15)
  changedBy Int?     @map("changed_by")
  note      String?
  changedAt DateTime @default(now()) @map("changed_at")

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  admin User? @relation("ChangedBy", fields: [changedBy], references: [id])

  @@map("status_history")
}